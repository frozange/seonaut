#!/usr/bin/python3 -I
"""Gateway from the lafactor account (SEOnaut on seo.lafactory.com) to Francis's
Claude subscription, through root's Claude Code CLI.

Installed 2026-11-10 at Francis's request ("ia avec mon forfait, usage personnel").
Twin of /usr/local/bin/sestaro-claude: the account may run THIS script through
sudo and nothing else (/etc/sudoers.d/seonaut-claude). The subscription token is
read here and never leaves root, so no credential is copied into a web account.

Contract:
  stdin   one JSON object {"model": str, "system": str, "prompt": str,
          "schema": object (optional, JSON Schema of the structured output),
          "effort": str (optional)}
  stdout  the CLI JSON envelope (--output-format json), unchanged
  exit    the CLI exit code, 64 on a refused request, 124 on timeout

The prompt carries text from third-party websites (prompt injection risk): the
CLI gets no tools, no MCP, no slash commands, no session and an empty throwaway
working directory, so it can only answer.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

CLI = "/root/.nvm/versions/node/v24.16.0/bin/claude"
MAX_STDIN = 1024 * 1024
TIMEOUT = 420
EFFORTS = ("low", "medium", "high", "xhigh", "max")
MODEL_RE = re.compile(r"^(?:claude-[a-z0-9][a-z0-9.\-]{1,60}|sonnet|opus|haiku)$")
SUBSCRIPTION_DIR = "/root/.claude-subscription"
SUBSCRIPTION_TOKEN = SUBSCRIPTION_DIR + "/token"


def refuse(message):
    print(json.dumps({"is_error": True, "subtype": "gateway_refused", "result": message}))
    sys.exit(64)


def subscription_token():
    try:
        with open(SUBSCRIPTION_TOKEN, encoding="utf-8") as f:
            return f.read().strip() or None
    except OSError:
        return None


def main():
    if len(sys.argv) != 1:
        refuse("no arguments accepted")
    raw = sys.stdin.buffer.read(MAX_STDIN + 1)
    if len(raw) > MAX_STDIN:
        refuse("request too large")
    try:
        req = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        refuse("stdin is not a JSON object")
    if not isinstance(req, dict):
        refuse("stdin is not a JSON object")

    model = str(req.get("model") or "sonnet")
    system = str(req.get("system") or "")
    prompt = str(req.get("prompt") or "")
    effort = str(req.get("effort") or "")
    schema = req.get("schema")
    if not MODEL_RE.match(model):
        refuse("model name refused")
    if not prompt.strip():
        refuse("empty prompt")
    if effort and effort not in EFFORTS:
        refuse("effort refused")
    if schema is not None and not isinstance(schema, dict):
        refuse("schema must be a JSON object")

    cli = os.path.realpath(CLI)
    if not os.path.isfile(cli):
        refuse("claude CLI not found at " + CLI)
    token = subscription_token()
    if not token:
        refuse("subscription token missing: " + SUBSCRIPTION_TOKEN)

    # Its own HOME: root's config holds a prepaid API key, which would win over
    # the subscription token. A subscription limit must fail loudly instead.
    home = SUBSCRIPTION_DIR + "/home"
    os.makedirs(home, mode=0o700, exist_ok=True)
    env = {
        "HOME": home,
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "DISABLE_AUTOUPDATER": "1",
        "DISABLE_TELEMETRY": "1",
        "CLAUDE_CODE_OAUTH_TOKEN": token,
    }
    argv = [cli, "-p", "--model", model, "--output-format", "json",
            "--tools", "", "--strict-mcp-config", "--disable-slash-commands",
            "--no-session-persistence"]
    if system:
        argv += ["--system-prompt", system]
    if effort:
        argv += ["--effort", effort]
    if schema is not None:
        argv += ["--json-schema", json.dumps(schema, ensure_ascii=False)]

    work = tempfile.mkdtemp(prefix="seonaut-claude-")
    try:
        try:
            r = subprocess.run(argv, input=prompt.encode("utf-8"), capture_output=True,
                               cwd=work, env=env, timeout=TIMEOUT)
        except subprocess.TimeoutExpired:
            print(json.dumps({"is_error": True, "subtype": "timeout", "result": "claude CLI timed out"}))
            sys.exit(124)
        sys.stdout.buffer.write(r.stdout)
        if r.returncode != 0 and not r.stdout.strip():
            sys.stdout.write(json.dumps({"is_error": True, "subtype": "cli_error",
                                         "result": r.stderr.decode("utf-8", "replace")[-400:]}))
        sys.exit(r.returncode)
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
